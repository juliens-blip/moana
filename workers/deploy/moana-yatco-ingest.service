[Unit]
Description=Moana YATCO ingest worker (docker compose run --rm worker)
After=network-online.target docker.service moana-yatco-collect.service
Wants=network-online.target
Requires=docker.service moana-yatco-collect.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/moana
EnvironmentFile=-/home/ubuntu/moana/.env.yatco
ExecStart=/usr/bin/flock -n /run/lock/moana-yatco.lock -c '/usr/bin/docker compose -f workers/docker/docker-compose.yatco.yml run --rm worker'
TimeoutStartSec=1200
