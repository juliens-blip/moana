FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN useradd --create-home --uid 10001 worker \
    && mkdir -p /data \
    && chown worker:worker /data

COPY --chown=worker:worker workers/yatco_ingest_worker.py /app/workers/yatco_ingest_worker.py

USER worker

CMD ["python", "-c", "import glob, json, logging, sys; sys.path.insert(0, '/app/workers'); from yatco_ingest_worker import Settings, ingest_listings; logging.basicConfig(level=logging.INFO); settings = Settings.from_env(); files = sorted(glob.glob('/data/page_*.json')); total_written = 0; total_dead = 0;\nfor path in files:\n    with open(path, encoding='utf-8') as fh:\n        listings = json.load(fh)\n    summary = ingest_listings(listings, settings)\n    total_written += len(summary.written)\n    total_dead += len(summary.dead_letters)\n    print(f'{path}: written={len(summary.written)} dead_letters={len(summary.dead_letters)}')\nprint(f'total: files={len(files)} written={total_written} dead_letters={total_dead}')"]
