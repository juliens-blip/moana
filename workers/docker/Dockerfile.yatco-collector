FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN useradd --create-home --uid 10001 worker \
    && mkdir -p /data \
    && chown worker:worker /data

COPY --chown=worker:worker scripts/yatco_collector.py /app/scripts/yatco_collector.py

USER worker

CMD ["python", "scripts/yatco_collector.py", "collect", "--output-dir", "/data", "--checkpoint-file", "/data/checkpoint.json"]
